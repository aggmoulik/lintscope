{
  "name": "@lintscope/core",
  "version": "0.0.0",
  "private": true,
  "description": "Lint-run orchestration: detection, scope resolution, multi-linter runs, report merging. Adapters live in @lintscope/adapters.",
  "license": "MIT",
  "author": "aggmoulik <qwertymoulik@gmail.com>",
  "homepage": "https://github.com/aggmoulik/lintscope",
  "repository": {
    "type": "git",
    "url": "https://github.com/aggmoulik/lintscope.git",
    "directory": "packages/core"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lintscope/adapters": "workspace:*",
    "@lintscope/schema": "workspace:*"
  },
  "devDependencies": {
    "@lintscope/tsconfig": "workspace:*",
    "@types/node": "26.1.1",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
