{
  "name": "@lintscope/adapters",
  "version": "0.0.0",
  "private": true,
  "description": "Linter adapter contract, registry, and built-in adapters. Add a linter by composing detect + buildArgs + map — see README.",
  "license": "MIT",
  "author": "aggmoulik <qwertymoulik@gmail.com>",
  "homepage": "https://github.com/aggmoulik/lintscope",
  "repository": {
    "type": "git",
    "url": "https://github.com/aggmoulik/lintscope.git",
    "directory": "packages/adapters"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./eslint": {
      "types": "./dist/linters/eslint/index.d.ts",
      "import": "./dist/linters/eslint/index.js"
    },
    "./biome": {
      "types": "./dist/linters/biome/index.d.ts",
      "import": "./dist/linters/biome/index.js"
    },
    "./oxc": {
      "types": "./dist/linters/oxc/index.d.ts",
      "import": "./dist/linters/oxc/index.js"
    },
    "./stylelint": {
      "types": "./dist/linters/stylelint/index.d.ts",
      "import": "./dist/linters/stylelint/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lintscope/schema": "workspace:*"
  },
  "devDependencies": {
    "@lintscope/tsconfig": "workspace:*",
    "@types/node": "26.1.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
