{
  "name": "@lintscope/studio-server",
  "version": "0.0.0",
  "private": true,
  "description": "Lint-agnostic framework for the Drizzle-Studio pattern: a local HTTP+CORS+SSE server that a hosted UI connects back to. Designed for standalone publish post-v1.0.",
  "license": "MIT",
  "author": "aggmoulik <qwertymoulik@gmail.com>",
  "homepage": "https://github.com/aggmoulik/lintscope",
  "repository": {
    "type": "git",
    "url": "https://github.com/aggmoulik/lintscope.git",
    "directory": "packages/studio-server"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "open": "11.0.0"
  },
  "devDependencies": {
    "@lintscope/tsconfig": "workspace:*",
    "@types/node": "25.9.2",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
