{
  "name": "@lintscope/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Source-of-truth React components for lintscope. Published to the shadcn registry at lintscope.vercel.app.",
  "license": "MIT",
  "author": "aggmoulik <qwertymoulik@gmail.com>",
  "homepage": "https://lintscope.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/aggmoulik/lintscope.git",
    "directory": "packages/ui"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta": {
      "types": "./dist/meta.d.ts",
      "import": "./dist/meta.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lintscope/schema": "workspace:*",
    "@radix-ui/react-accordion": "1.2.13",
    "@radix-ui/react-dialog": "1.1.16",
    "@tanstack/react-virtual": "3.14.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "diff": "9.0.0",
    "lucide-react": "1.16.0",
    "parse-diff": "0.12.0",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@lintscope/tsconfig": "workspace:*",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "happy-dom": "20.10.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
