{
  "name": "lintscope",
  "version": "0.1.1",
  "description": "A polished UI for your linter — runs in your browser, data stays on your machine. CLI half of the lintscope.dev pair.",
  "license": "MIT",
  "author": "aggmoulik <qwertymoulik@gmail.com>",
  "homepage": "https://github.com/aggmoulik/lintscope",
  "repository": {
    "type": "git",
    "url": "https://github.com/aggmoulik/lintscope.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/aggmoulik/lintscope/issues",
  "keywords": [
    "eslint",
    "biome",
    "oxlint",
    "lint",
    "dashboard",
    "studio",
    "cli"
  ],
  "type": "module",
  "bin": {
    "lintscope": "./dist/lintscope.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "4.0.3",
    "commander": "13.0.0"
  },
  "devDependencies": {
    "@lintscope/api-schema": "workspace:*",
    "@lintscope/core": "workspace:*",
    "@lintscope/schema": "workspace:*",
    "@lintscope/studio-server": "workspace:*",
    "@lintscope/tsconfig": "workspace:*",
    "@types/node": "25.9.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
