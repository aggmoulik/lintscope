{
  "name": "lintscope-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "A shadcn-style component registry and CLI for viewing lint output in a real UI.",
  "license": "MIT",
  "author": "aggmoulik <qwertymoulik@gmail.com>",
  "homepage": "https://github.com/aggmoulik/lintscope",
  "repository": {
    "type": "git",
    "url": "https://github.com/aggmoulik/lintscope.git"
  },
  "bugs": "https://github.com/aggmoulik/lintscope/issues",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=@lintscope/registry --ui=stream",
    "test": "turbo test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo typecheck",
    "ui:add": "pnpm --filter @lintscope/ui exec -- pnpm dlx shadcn@latest add",
    "changeset": "changeset",
    "release": "turbo build --filter='./packages/*' && changeset publish"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "turbo": "2.10.5",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
